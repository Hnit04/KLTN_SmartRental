# ============================================
# SmartRental - Environment Variables
# Copy file này thành .env và điền giá trị thật
# ============================================

# === DATABASE ===
DB_PASSWORD=your_db_password

# === SPRING PROFILE ===
# Sử dụng 'production' cho deploy, 'default' cho dev
SPRING_PROFILE=default

# === SECURITY ===
JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters

# === CLOUDINARY (Image Upload) ===
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# === AI APIs ===
FPT_AI_KEY=your_fpt_ai_key
GEMINI_API_KEY=your_gemini_api_key

# === BLOCKCHAIN ===
BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BLOCKCHAIN_PRIVATE_KEY=your_private_key
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_VND_ETH_RATE=80000000

# === EMAIL (Brevo) ===
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_sender_email
BREVO_SENDER_NAME=SmartRental

# === GOOGLE AUTH ===
GOOGLE_CLIENT_ID=your_google_client_id

# === FRONTEND ===
VITE_API_URL=http://localhost:8080
