# Database
DB_URL=jdbc:mariadb://localhost:3307/smart_rental_db?useSSL=false&serverTimezone=UTC&useUnicode=true&characterEncoding=utf8mb4
DB_USERNAME=root
DB_PASSWORD=root

# Security
JWT_SECRET=your_jwt_secret_here

# Third-party APIs
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
FPT_AI_KEY=your_fpt_ai_key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_CHAT_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_CHAT_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_CHAT_TEMPERATURE=0.7
GEMINI_CHAT_TIMEOUT_SECONDS=120

# RAG Retrieval / Embedding (optional)
AI_RAG_EMBEDDING_MODEL=all-minilm-l6-v2
AI_RAG_RETRIEVAL_MAX_RESULTS=4
AI_RAG_RETRIEVAL_MIN_SCORE=0.55
# Dùng khi AI_RAG_EMBEDDING_MODEL=onnx-custom hoặc onnx-multilingual
AI_RAG_ONNX_MODEL_PATH=
AI_RAG_ONNX_TOKENIZER_PATH=
AI_RAG_ONNX_POOLING_MODE=MEAN

# Blockchain
BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BLOCKCHAIN_PRIVATE_KEY=your_private_key_here
BLOCKCHAIN_CHAIN_ID=11155111

# Email (Brevo)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_sender_email
BREVO_SENDER_NAME=SmartRental

# Auth
GOOGLE_CLIENT_ID=your_google_client_id
