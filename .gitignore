# =============================================
# SmartRental Monorepo — Root .gitignore
# =============================================

# ── IDE / Editor ──
.idea/
.vscode/
*.iws
*.iml
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS artifacts ──
.DS_Store
Thumbs.db
Desktop.ini

# ── Node / NPM (root Hardhat) ──
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Hardhat / Solidity build ──
build/
cache/
artifacts/
typechain-types/

# ── Java / Spring Boot (backend) ──
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/uploads/
backend/models/**/*.onnx
*.class
*.jar
*.war
*.ear

# ── Frontend build output ──
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/package-lock.json
*.local

# ── Environment / Secrets (CRITICAL) ──
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# ── Logs ──
*.log
logs/

# ── Temp / scratch files ──
*.tmp
*.bak
*.swp
*~
backend/fix_clearcache.*
plan/_tc_rows_tmp.txt
plan/_preconditions_unique.txt

# ── Test output ──
frontend/coverage/
backend/surefire-reports/

# ── LaTeX build artifacts (nckh) ──
nckh/*.aux
nckh/*.log
nckh/*.out
nckh/*.toc
nckh/*.bbl
nckh/*.blg
nckh/*.synctex.gz
nckh/*.fdb_latexmk
nckh/*.fls

# ── Antigravity / Gemini agent data ──
.gemini/
.antigravityignore

plan/
nckh/
img/